      "parameters": {
        "jsCode": "function getFields(item) {\n    if (!item) return {};\n    const data = item.json || item;\n    return data.fields ? data.fields : data;\n}\nfunction getId(item) {\n    if (!item) return \"\";\n    const data = item.json || item;\n    return data.id || \"\";\n}\n\nlet rawLists = [];\ntry { rawLists = $('Airtable 취향목록 전체 조회').all(); } catch (e) { rawLists = []; }\nif (!Array.isArray(rawLists)) rawLists = [rawLists];\n\nlet rawItems = [];\ntry { rawItems = $('Airtable 취향항목 전체 조회').all(); } catch (e) { rawItems = []; }\nif (!Array.isArray(rawItems)) rawItems = [rawItems];\n\nconst lists = rawLists.map(r => ({ id: getId(r), fields: getFields(r) }))\n    .filter(r => r.fields && Object.keys(r.fields).length > 0);\n\nconst items = rawItems.map(r => ({ id: getId(r), fields: getFields(r) }))\n    .filter(r => r.fields && Object.keys(r.fields).length > 0);\n\nconst itemsByListId = {};\nitems.forEach(it => {\n    const links = it.fields.소속목록 || [];\n    links.forEach(listId => {\n        if (!itemsByListId[listId]) itemsByListId[listId] = [];\n        itemsByListId[listId].push({\n            id: it.id,\n            제목: it.fields.제목 || \"\",\n            순위: it.fields.순위 !== undefined ? it.fields.순위 : 999,\n            코멘트: it.fields.코멘트 || \"\",\n            \"이미지/링크\": it.fields[\"이미지/링크\"] || \"\"\n        });\n    });\n});\nObject.keys(itemsByListId).forEach(listId => {\n    itemsByListId[listId].sort((a, b) => a.순위 - b.순위);\n});\n\nconst listsByCategory = {};\nlists.forEach(l => {\n    const category = l.fields.대분류 || \"미분류\";\n    if (!listsByCategory[category]) listsByCategory[category] = [];\n    listsByCategory[category].push({\n        id: l.id,\n        소분류명: l.fields.소분류명 || \"\",\n        표시순서: l.fields.표시순서 !== undefined ? l.fields.표시순서 : 999,\n        항목: itemsByListId[l.id] || []\n    });\n});\nObject.keys(listsByCategory).forEach(category => {\n    listsByCategory[category].sort((a, b) => a.표시순서 - b.표시순서);\n});\n\nconst categories = Object.keys(listsByCategory).sort().map(category => ({\n    대분류: category,\n    소분류목록: listsByCategory[category]\n}));\n\nreturn [{ json: { categories } }];"
      },
